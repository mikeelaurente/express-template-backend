{
    "name": "nodejs-backend-starter",
    "version": "1.0.0",
    "description": "A minimal, reusable Node.js + TypeScript + Express backend template",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "nodejs",
        "typescript",
        "express",
        "backend",
        "template",
        "starter"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "dotenv": "^16.3.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "typescript": "^5.2.2",
        "tsx": "^4.6.2",
        "@types/express": "^4.17.21",
        "@types/node": "^20.9.0"
    }
}