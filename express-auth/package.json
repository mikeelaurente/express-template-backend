{
    "name": "express-auth-starter",
    "version": "1.0.0",
    "description": "A reusable Express.js + TypeScript authentication starter template",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "nodejs",
        "typescript",
        "express",
        "authentication",
        "jwt",
        "template",
        "starter"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "dotenv": "^16.3.1",
        "zod": "^3.22.4",
        "bcrypt": "^5.1.1",
        "jsonwebtoken": "^9.1.2"
    },
    "devDependencies": {
        "typescript": "^5.2.2",
        "tsx": "^4.6.2",
        "@types/express": "^4.17.21",
        "@types/node": "^20.9.0",
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.6"
    }
}